{
  "bar": {
    "id": "ruixen.bar",
    "position": "top",
    "transparent": true,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "ruixen.workspaces"
        },
        {
          "id": "ruixen.pinnedapps"
        },
        {
          "id": "ruixen.applauncher"
        },
        {
          "id": "aislandener.galaxy-buds"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "jkoestinger.vpn"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "io.github.ajanraj.disposable-email"
        },
        {
          "id": "ruixen.stayawake"
        }
      ],
      "center": [
        {
          "id": "ruixen.weather"
        },
        {
          "id": "omarchy.clock",
          "format": "HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "right": [
        {
          "id": "ruixen.tray",
          "hidden": []
        },
        {
          "id": "ruixen.pluginpins"
        },
        {
          "id": "io.github.viganogabriele.agent-usage-plus",
          "refreshIntervalSec": 300,
          "providers": {
            "claude": {
              "barLabelMode": "full",
              "barRole": "fixed",
              "enabled": true,
              "primary": false,
              "showInBar": true
            },
            "codex": {
              "barLabelMode": "full",
              "barRole": "fixed",
              "enabled": true,
              "primary": false,
              "showInBar": true
            },
            "cursor": {
              "barLabelMode": "icon",
              "barRole": "fixed",
              "enabled": false,
              "primary": false,
              "showInBar": false
            },
            "deepseek": {
              "barLabelMode": "icon",
              "barRole": "fixed",
              "enabled": false,
              "primary": false,
              "showInBar": false
            },
            "fireworks": {
              "barLabelMode": "icon",
              "barRole": "fixed",
              "enabled": false,
              "primary": false,
              "showInBar": false
            },
            "gemini": {
              "barLabelMode": "full",
              "barRole": "fixed",
              "enabled": false,
              "primary": false,
              "showInBar": false
            },
            "kimi": {
              "barRole": "fixed",
              "enabled": false,
              "primary": false,
              "showInBar": false
            },
            "openrouter": {
              "barLabelMode": "icon",
              "barRole": "fixed",
              "enabled": false,
              "primary": false,
              "showInBar": false
            },
            "xai": {
              "barRole": "fixed",
              "enabled": false,
              "primary": false,
              "showInBar": false
            },
            "zai": {
              "barRole": "fixed",
              "enabled": false,
              "primary": false,
              "showInBar": false
            },
            "devin": {
              "enabled": false,
              "showInBar": false,
              "barRole": "fixed"
            }
          },
          "barMode": "all",
          "warnThresholdPct": 75,
          "criticalThresholdPct": 90,
          "barLabelMode": "full",
          "barCycleSlots": 1,
          "barCycleIntervalSec": 3,
          "notificationsEnabled": true,
          "providerOrder": "[\"claude\",\"codex\"]",
          "colorfulUsageMeters": false,
          "showAvailablePercentage": false,
          "syncMode": false,
          "openInDetailedView": false
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "ruixen.quickactions"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        },
        {
          "id": "ruixen.settingsbutton"
        }
      ]
    },
    "docked": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "io.github.ok.omakoe"
    },
    {
      "id": "ruixen.settings"
    },
    {
      "id": "ruixen.media"
    },
    {
      "id": "ruixen.wallpaper"
    },
    {
      "id": "ruixen.notch"
    },
    {
      "id": "ruixen.frame-widget"
    },
    {
      "id": "ruixen.launcher"
    }
  ],
  "version": 1
}
