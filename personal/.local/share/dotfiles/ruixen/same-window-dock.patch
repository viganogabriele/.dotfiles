diff --git a/tests/dock-background-live.py b/tests/dock-background-live.py
new file mode 100644
index 0000000..980ee86
--- /dev/null
+++ b/tests/dock-background-live.py
@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""Render the installed dock rectangle with a growing tray using real Qt Quick."""
+from pathlib import Path
+import os
+import re
+import subprocess
+import tempfile
+
+repo = Path(__file__).resolve().parent.parent
+source = (repo / "bars/v2/ruixen.bar/BarPanel.qml").read_text()
+identifier = source.index("        id: rightDockedBg")
+start = source.rfind("      Rectangle {", 0, identifier)
+end = source.index("\n      }", identifier) + 8
+rectangle = source[start:end]
+bar = (repo / "bars/v2/ruixen.bar/Bar.qml").read_text()
+owner = re.search(r"readonly property bool frameOwnsDockChrome: (true|false)", bar).group(1)
+qml = '''import QtQuick
+import QtTest
+Item {
+ id: barWindow
+ width: 1024; height: 80
+ property var barRoot: QtObject {
+  property bool docked: true
+  property bool frameOwnsDockChrome: OWNER
+  property int barSize: 34
+  property color dockedBarColor: "black"
+  property var dockedSkin: QtObject { property bool dockSpansFullWidth: false }
+ }
+ Item {
+  id: horizontalBarRoot
+  width: 1024; height: 58
+  property int trayCount: 2
+  function publishDockChromeMetrics() {}
+  RECTANGLE
+  Item {
+   id: trayPill
+   x: horizontalBarRoot.width - width - 220
+   width: icons.implicitWidth + 40; height: 34
+   Row {
+    id: icons
+    x: 20; y: 11
+    Repeater {
+     model: horizontalBarRoot.trayCount
+     Rectangle { width: 20; height: 12; color: "white" }
+    }
+   }
+  }
+ }
+ TestCase {
+  name: "DockBackground"
+  when: windowShown
+  function test_backgroundGrowsWithNewTrayIcons() {
+   compare(rightDockedBg.visible, true)
+   tryCompare(trayPill, "width", 80)
+   compare(rightDockedBg.x, 724)
+   compare(grabImage(horizontalBarRoot).red(578,17), 255)
+   horizontalBarRoot.trayCount = 10
+   tryCompare(trayPill, "width", 240)
+   tryCompare(rightDockedBg, "x", 564)
+   compare(rightDockedBg.width, 460)
+   tryVerify(function() { return grabImage(horizontalBarRoot).red(578,17) === 0 })
+   // The leading icon keeps the same padding as the group expands.
+   compare(icons.mapToItem(horizontalBarRoot,0,0).x - rightDockedBg.x, 20)
+  }
+ }
+}
+'''.replace("OWNER", owner).replace("RECTANGLE", rectangle)
+env = dict(os.environ, QT_QPA_PLATFORM="offscreen",
+           QT_QPA_PLATFORMTHEME="generic", QT_STYLE_OVERRIDE="Fusion")
+runner = "/usr/lib/qt6/bin/qmltestrunner"
+if not Path(runner).is_file():
+    raise SystemExit("Qt 6 qmltestrunner is required for this focused runtime check")
+with tempfile.TemporaryDirectory(prefix="ruixen-dock-background-") as directory:
+    (Path(directory) / "tst_background.qml").write_text(qml)
+    raise SystemExit(subprocess.run([runner, "-input", directory], env=env).returncode)
