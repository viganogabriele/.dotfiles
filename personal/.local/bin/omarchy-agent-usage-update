#!/bin/bash

# omarchy:summary=Regenerate the AI agent usage data files (local override)
# omarchy:args=[--force] [--limits-only] [--except <agent>] [agent...]

# Local override of the packaged omarchy-agent-usage-update. Same logic,
# except the codex collector is swapped for
# ~/.local/bin/agent-usage-plus-base-codex, which fixes the
# `-a untrusted` flag rejected by Codex CLI >= 0.150 (see
# io.github.viganogabriele.agent-usage-plus/collectors/bin/omarchy-agent-usage-codex-cost).

USAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage"
COLLECTOR_BIN="${AGENT_USAGE_PLUS_COLLECTOR_BIN:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/io.github.viganogabriele.agent-usage-plus/collectors/bin}"
mkdir -p "$USAGE_DIR"

flags=()
only=()
declare -A excluded

while [[ $# -gt 0 ]]; do
  case "$1" in
  --force | --limits-only) flags+=("$1") ;;
  --except)
    excluded[$2]=1
    shift
    ;;
  *) only+=("$1") ;;
  esac
  shift
done

wanted() {
  local agent="$1"
  [[ -n ${excluded[$agent]} ]] && return 1
  (( ${#only[@]} == 0 )) && return 0
  local candidate
  for candidate in "${only[@]}"; do
    [[ $candidate == "$agent" ]] && return 0
  done
  return 1
}

collect() {
  local collector="$1" agent="$2"
  shift 2
  local -a collector_env=("$@")
  local record tmp
  if ((${#collector_env[@]} > 0)); then
    record=$(env "${collector_env[@]}" "$collector" "${flags[@]}") || true
  else
    record=$("$collector" "${flags[@]}") || true
  fi
  if [[ -z $record ]] || ! jq -e . >/dev/null 2>&1 <<<"$record"; then
    echo "omarchy-agent-usage-update: $agent collector failed" >&2
    return 1
  fi
  tmp=$(mktemp "$USAGE_DIR/.$agent.XXXXXX")
  printf '%s\n' "$record" >"$tmp"
  mv "$tmp" "$USAGE_DIR/$agent.json"
}

pids=()
for collector in "$OMARCHY_PATH"/bin/omarchy-agent-usage-*; do
  [[ -x $collector ]] || continue
  agent="${collector##*/omarchy-agent-usage-}"
  [[ $agent == "update" ]] && continue
  wanted "$agent" || continue
  base_collector="$collector"
  if [[ $agent == "codex" && -x "$HOME/.local/bin/agent-usage-plus-base-codex" ]]; then
    collector="$HOME/.local/bin/agent-usage-plus-base-codex"
  fi
  cost_collector="$COLLECTOR_BIN/omarchy-agent-usage-$agent-cost"
  collector_env=()
  if [[ -x $cost_collector ]]; then
    case "$agent" in
      claude) collector_env=("AGENT_USAGE_PLUS_CLAUDE_BASE_COLLECTOR=$base_collector") ;;
      codex) collector_env=("AGENT_USAGE_PLUS_CODEX_BASE_COLLECTOR=$collector") ;;
    esac
    if ((${#collector_env[@]} > 0)); then
      collector="$cost_collector"
    fi
  fi
  collect "$collector" "$agent" "${collector_env[@]}" &
  pids+=($!)
done

status=0
for pid in "${pids[@]}"; do
  wait "$pid" || status=1
done
exit $status
