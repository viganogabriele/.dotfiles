# --- Firewall / dev ports ---
# fixnet removed: automated by the udev rule + /usr/local/bin/fixnet-flap.sh
# (see system/udev/99-ethernet-fix.rules) - the USB-C ethernet adapter now
# flaps itself a few seconds after plug-in.

# Open/close dev ports on the firewall on demand (e.g. testing pnpm dev from mobile).
# No argument: 3000 (Next.js/dev), 5500 (Live Server), 8081 (Metro/Expo).
# Usage: devopen [port] | devclose [port]
DEV_PORTS=(3000 5500 8081)
devopen() {
  local ports=("${@:-${DEV_PORTS[@]}}")
  pkexec sh -c "$(for p in "${ports[@]}"; do echo "ufw allow $p/tcp;"; done)" \
    && echo "Porte aperte: ${ports[*]}"
}
devclose() {
  local ports=("${@:-${DEV_PORTS[@]}}")
  pkexec sh -c "$(for p in "${ports[@]}"; do echo "ufw delete allow $p/tcp;"; done)" \
    && echo "Porte chiuse: ${ports[*]}"
}

