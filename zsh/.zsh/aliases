# --- Navigation ---
alias ..='cd ..' # Go up one directory
alias ...='cd ../..' # Go up two directories
alias ....='cd ../../..' # Go up three directories
zd() { # zoxide-aware cd: real dir -> plain cd, otherwise try a zoxide jump, no args -> home
  if (( $# == 0 )); then
    builtin cd ~ || return
  elif [[ -d $1 ]]; then
    builtin cd "$1" || return
  else
    if ! z "$@"; then
      echo "Error: Directory not found"
      return 1
    fi
    printf "\U000F17A9 "
    pwd
  fi
}
alias cd='zd' # Use the zoxide-aware cd everywhere

# --- Files (eza) ---
alias ls='eza -lh --group-directories-first --icons=auto' # List files with details; directories first; show icons
alias lsa='ls -a' # List all files, including hidden ones
alias ll='eza -lah --group-directories-first --icons=auto' # List all files with details, including hidden
alias lt='eza --tree --level=2 --long --icons --git' # Directory tree (2 levels) with details, icons, and Git info
alias lta='lt -a' # Tree view including hidden files
alias ltt='eza --tree --level=3 --long --icons --git' # Directory tree (3 levels) with details and Git info

# --- Fuzzy search (fzf) ---
if [[ "$TERM" == "xterm-kitty" ]]; then
  alias ff="fzf --preview 'case \$(file --mime-type -b {}) in image/*) kitty icat --clear --transfer-mode=memory --stdin=no --place=\${FZF_PREVIEW_COLUMNS}x\${FZF_PREVIEW_LINES}@0x0 {} ;; *) bat --style=numbers --color=always {} ;; esac'" # Fuzzy-find a file, with inline image preview in Kitty
else
  alias ff="fzf --preview 'bat --style=numbers --color=always {}'" # Fuzzy-find a file, with a syntax-highlighted preview
fi
alias eff='$EDITOR "$(ff)"' # Fuzzy-find a file and open it in $EDITOR

